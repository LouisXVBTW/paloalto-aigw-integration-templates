{
  "$schemaVersion": 2,
  "inference": {
    "provider": "gateway",
    "baseUrl": "https://aigw.portkey.ai",
    "customHeaders": {
      "x-portkey-api-key": "YOUR_API_KEY",
      "x-portkey-provider": "YOUR_PROVIDER_SLUG"
    },
    "credential": {
      "kind": "static",
      "apiKey": "YOUR_API_KEY"
    }
  },
  "models": {
    "discoveryEnabled": false,
    "list": [
      {
        "name": "YOUR_MODEL_ID",
        "labelOverride": "claude opus 4-5",
        "anthropicFamilyTier": "opus"
      }
    ]
  }
}
